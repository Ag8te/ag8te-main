# Copy this file to .env and replace every required placeholder.
# Never commit .env or .env.production. Keep DB_PASSWORD and the password
# component of DATABASE_URL identical; URL-encode special characters in the URL.

WEB_PORT=80
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
FRONTEND_URL=https://ag8te.com
BACKEND_URL=https://ag8te.com
MOBILE_APP_URL=co.za.ag8te.app://app
NGINX_CONF=./nginx_dir/new/nginx.docker.conf

POSTGRES_DB=ag8te
POSTGRES_USER=ag8te
DB_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://ag8te:replace-with-the-url-encoded-database-password@db:5432/ag8te

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
DEFAULT_FROM_EMAIL=noreply@ag8te.com

YOCO_SECRET_KEY=
YOCO_API_URL=https://payments.yoco.com/api

SHIPLOGIC_ENABLED=0
SHIPLOGIC_API_KEY=
SHIPLOGIC_API_URL=https://api.shiplogic.com
SHIPLOGIC_COLLECTION_COMPANY=
SHIPLOGIC_COLLECTION_NAME=
SHIPLOGIC_COLLECTION_PHONE=
SHIPLOGIC_COLLECTION_EMAIL=
SHIPLOGIC_COLLECTION_STREET_ADDRESS=
SHIPLOGIC_COLLECTION_LOCAL_AREA=
SHIPLOGIC_COLLECTION_CITY=
SHIPLOGIC_COLLECTION_ZONE=
SHIPLOGIC_COLLECTION_CODE=
SHIPLOGIC_COLLECTION_COUNTRY=ZA
SHIPLOGIC_AUTOMATIC_SHIPMENT_CREATION=1

GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_PLAY_REVIEW_EMAIL=
HUAWEI_REVIEW_EMAIL=

GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

AURA_CLIENT_ID=
AURA_SECRET_KEY=
AURA_BASE_URL=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_API_URL=https://api-m.paypal.com
